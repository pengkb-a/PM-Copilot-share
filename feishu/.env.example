# 飞书开放平台应用凭证（必填）
# 获取方式：open.feishu.cn 创建自建应用，获取 App ID / App Secret
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 你的飞书租户域名（浏览器地址栏 xxx.feishu.cn）
FEISHU_TENANT_DOMAIN=xxx.feishu.cn

# OAuth 权限范围（一般不用改）
FEISHU_SCOPES=docx:document drive:drive offline_access board:whiteboard:node:create board:whiteboard:node:read

# 可选：文档创建到哪个文件夹（不填则创建到"我的空间"根目录）
# 获取方式：进入目标文件夹，看地址栏 /drive/folder/fldcnXXX → fldcnXXX 就是 token
FEISHU_FOLDER_TOKEN=

# 可选：已有文档的 token，仅用于 check/blocks/append 命令
FEISHU_DOCUMENT_ID=

# 可选：自定义 OAuth 回调端口（默认 3000）
# FEISHU_OAUTH_PORT=3000
# FEISHU_REDIRECT_URI=http://localhost:3000/callback

# ── 机器人通知（可选；不填则 notify.mjs 静默跳过，不影响主流程）──
# 获取方式：飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 webhook 地址
FEISHU_BOT_WEBHOOK=